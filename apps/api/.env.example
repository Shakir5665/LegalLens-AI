APP_NAME=LegalLens AI API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database
DATABASE_URL=
# AI Model
GEMINI_API_KEY=

# Frontend
CORS_ORIGINS=http://localhost:5173

# Neon Cloud Object Storage (S3-Compatible, AWS Singapore ap-southeast-1)
# Required when STORAGE_PROVIDER=neon
STORAGE_PROVIDER=neon
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_BUCKET=legal-lense-ai
NEON_STORAGE_ACCESS_KEY=
NEON_STORAGE_SECRET_KEY=

