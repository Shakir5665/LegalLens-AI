APP_NAME=LegalLens AI API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database (Phase 3 PostgreSQL - Local or Neon Cloud)
# Format: postgresql+psycopg://username:password@host:port/database_name?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/legallens_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_CONNECT_TIMEOUT=10.0

# Document Storage & Ingestion (Phase 3 & Refinements)
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_BYTES=26214400
STORAGE_PROVIDER=local
STORAGE_URL_EXPIRY_SECONDS=600

# Neon Cloud Object Storage (S3-Compatible, AWS Singapore ap-southeast-1)
# Required when STORAGE_PROVIDER=neon
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=ap-southeast-1
NEON_STORAGE_BUCKET=legallens-documents
NEON_STORAGE_ACCESS_KEY=
NEON_STORAGE_SECRET_KEY=

# AI Model
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend
CORS_ORIGINS=http://localhost:5173


